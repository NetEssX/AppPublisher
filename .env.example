# 复制为 .env 后按需修改。所有项都可以不配，不配就用注释里的默认值。

# ---- 对外地址 ----
# 生成 download 字段时用的站点前缀，必须以 http(s):// 开头，结尾不带斜杠。
# 留空则按请求的 Host 头动态推断（单机直连时可用；放在 Nginx 反代后建议显式配置）。
PUBLIC_BASE_URL=https://example.com

# ---- 初始管理员 ----
# 首次启动、数据库里还没有任何账号时创建。密码留空则随机生成并打印在启动日志里。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 会话 ----
# 不配会自动生成并保存到 data/.secret_key（重启后会话不失效）。
# SECRET_KEY=
# 生产环境跑 HTTPS 时设为 1，浏览器才肯在跨站场景带上 Cookie。
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
SESSION_MAX_AGE=604800

# ---- 上传限制（单位 MB）----
MAX_BUILD_MB=1024
MAX_IMAGE_MB=8
MAX_INTRO_MB=4

# ---- 允许分发的产物类型 ----
# 内置 .apk .aab .ipa .exe .msi .dmg .pkg .deb .rpm .appimage .zip .7z .tar.gz .tgz .gz .xz .zst .jar
# 需要别的类型就在下面追加（逗号分隔，点可有可无），不用改代码。
# EXTRA_BUILD_EXTENSIONS=.bin,.rom,.xapk

# ---- 访问统计 ----
# 明细保留天数，超期自动清理
STATS_RETENTION_DAYS=180
# 后台统计页与应用列表默认展示的区间
STATS_DEFAULT_RANGE_DAYS=30
# 只有在反向代理会覆写 X-Forwarded-For 时才开启，否则客户端可伪造来源 IP
TRUST_PROXY_HEADERS=0

# ---- 数据目录 ----
# APPPUBLISHER_DATA_DIR=./data
# APPPUBLISHER_DB=./data/apppublisher.db
